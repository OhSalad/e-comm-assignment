{
  "name": "student-grade-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "node server/index.js",
    "start:frontend": "vite --host 127.0.0.1",
    "dev": "npm start",
    "server": "npm run start:backend",
    "client": "npm run start:frontend",
    "build": "vite build",
    "serve": "node server/index.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "express": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sqlite3": "latest",
    "vite": "latest"
  }
}
